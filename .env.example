# IntelliStudy backend configuration. Copy to `.env` (git-ignored, never committed) and fill in real values.
# Contract: docs/backend_security_contract.md, section 8. Secrets live only in environment variables / .env.

# demo | prod
INTELLISTUDY_PROFILE=demo

# REQUIRED. At least 32 random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTELLISTUDY_JWT_SECRET=replace-with-output-of-secrets.token_urlsafe-32

# LLM provider: deepseek | openai | local | none
INTELLISTUDY_LLM_PROVIDER=deepseek
# Optional overrides (defaults: deepseek-chat at https://api.deepseek.com)
# INTELLISTUDY_LLM_MODEL=deepseek-chat
# INTELLISTUDY_LLM_BASE_URL=
INTELLISTUDY_DEEPSEEK_API_KEY=your-api-key-here
# INTELLISTUDY_OPENAI_API_KEY=your-api-key-here

# Storage (SQLite for the demo; a PostgreSQL URL works without code changes)
INTELLISTUDY_DATABASE_URL=sqlite:///data/backend/intellistudy.sqlite3
INTELLISTUDY_DATA_DIR=data/backend
INTELLISTUDY_STORAGE_ROOT=data/backend/storage

# Comma-separated, no wildcards
INTELLISTUDY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
